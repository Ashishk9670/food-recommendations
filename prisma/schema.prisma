// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recommendation {
  id             Int      @id @default(autoincrement())
  dishName       String
  category       String
  rating         Int
  // default lets this NOT NULL column backfill existing rows; the app always supplies a real value on create
  price          Float    @default(0)
  imageUrl       String
  // default lets this NOT NULL column backfill existing rows; the app always supplies a real value on create
  restaurantName String   @default("")
  reviewerName   String?
  notes          String?
  likeCount      Int      @default(0)
  reportCount    Int      @default(0)
  // secret token generated at creation time; lets the submitter's browser edit/delete later with no real accounts
  editToken      String   @default("")
  createdAt      DateTime @default(now())
}

model DeletionLog {
  id             Int      @id @default(autoincrement())
  dishName       String
  restaurantName String
  deletedAt      DateTime @default(now())
}
